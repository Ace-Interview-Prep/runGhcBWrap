cabal-version: >= 1.10
name: runGhcBWrap
version: 0.1.0.0
build-type: Simple

library
  hs-source-dirs: src
  default-language: Haskell2010
  build-depends:
      base
    , text
    , which
    , directory
    , filepath
    , process
    , split
    , temporary
    , runGhcBWrap-core
  exposed-modules:
        RunGhcBWrap

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  default-language: Haskell2010
  build-depends:
      base
    , runGhcBWrap
    , runGhcBWrap-core
    , tasty
    , tasty-hunit
    , text
